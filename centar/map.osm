  <tag k="start_date" v="10.7.2012"/>
  <tag k="tourism" v="artwork"/>
 </node>
 <node id="9078062192" visible="true" version="6" changeset="190639888" timestamp="2026-10-17T09:08:30Z" user="Македонија" uid="24396824" lat="41.9940339" lon="21.4333058">
  <tag k="artwork_type" v="statue"/>
  <tag k="description" v="Историската позадина на овој споменик е поврзана со жените и женската младина од Скопје и цела Македонија активно учествувале во многу акции организирани од СКОЈ и синдикатите. Во 1940 година била основана „Женска набавна задруга“ во која членувале околу"/>
