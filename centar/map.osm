  <tag k="cost" v="153.516 euro"/>
  <tag k="description" v="Историско значење Петар Богдани — римокатолички бискуп скадарски (1656 — 1671) и надбискуп скопски (1671 — 1689). Се бавел со книжевна работа, а творел на албански, италијански и латински јазик.&#10;Излеан во бронза, висок 5 метри, поставен на триметарски пос"/>
  <tag k="investitor" v="Општина Центар"/>
  <tag k="learnica" v="Фондериа Артистика Гуастини"/>
