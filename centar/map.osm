  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Невена Николова Георгиева-Дуња (25 јули 1925 во Скопје — 16 декември 1942 во Нежилово) — македонска комунистка, припадничка на младинското, синдикалното и работничкото движење меѓу двете светски војни, учесник во НОВ од 1941 година. Со своите 16 години би"/>
  <tag k="memorial" v="statue"/>
  <tag k="name" v="Невена Георгиева-Дуња"/>
 </node>
 <node id="9078062190" visible="true" version="6" changeset="190639888" timestamp="2026-10-17T09:08:30Z" user="Македонија" uid="24396824" lat="41.9939185" lon="21.4331138">
